NEXT_PUBLIC_APP_URL=http://localhost:3007
DEPLOYMENT_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001

# D-077: which organization this deployment serves. Its `ui_locale` decides the
# platform UI language, so a wrong value here is a wrong-language site. Must be
# registered in src/lib/tenant/organizations.ts — an unknown slug throws rather
# than quietly falling back to the platform default (`en`).
DEFAULT_ORGANIZATION_SLUG=psihointegritet

# B2: the host that serves the owners' workspace and the operator console.
# Tenant domains come from src/lib/tenant/domain-registry.ts; this is the one
# host where an owner's organization comes from their membership instead.
# Required on every deployed environment — unset, /radni-prostor and /superadmin
# answer nowhere. Today it is the founding tenant's domain (which is therefore
# both platform and tenant host); it becomes p-digital-center.com later.
# Left empty locally: localhost and 127.0.0.1 are always treated as platform.
#
# Vercel, verified 2026-09-07:
#   Production           psihointegritet.com
#   Preview              qa.psihointegritet.com
#   Preview (staging)    staging.psihointegritet.com
#
# A preview deployment has no custom domain, so its *.vercel.app host names no
# tenant; outside production it falls back to DEFAULT_ORGANIZATION_SLUG and
# serves both surfaces, so a branch can be reviewed from its preview link.
PLATFORM_HOST=

# Production Intake & Matching stays disabled until legal copy versions are approved.
NEXT_PUBLIC_INTAKE_MATCHING_ENABLED=false
NEXT_PUBLIC_INTAKE_SENSITIVE_SUBMISSION_ENABLED=false
NEXT_PUBLIC_INTAKE_TEAM_QUEUE_ENABLED=false
NEXT_PUBLIC_INTAKE_DATA_PROCESSING_NOTICE_VERSION=
NEXT_PUBLIC_INTAKE_REQUEST_ACKNOWLEDGEMENT_VERSION=

# Demo email sending (Research survey + B2B inquiry) via Resend Route Handlers.
# No backend/persistence — migrates to the notifications backend in R1.3.
# If RESEND_API_KEY is unset, the survey endpoint returns 503 (never crashes).
RESEND_API_KEY=
SURVEY_RECIPIENT_EMAIL=info@psihointegritet.com
RESEND_FROM_EMAIL=Psihointegritet <noreply@psihointegritet.com>

# D-059: the public Kompas activates per environment. Unset means off — /kompas
# and its taxonomy routes answer 404, the header link and landing CTA disappear,
# and the sitemap lists no Kompas route. Turn it on only where the backend
# serves modules/compass and a flow is published.
NEXT_PUBLIC_COMPASS_ENABLED=true

NEXT_PUBLIC_COMPASS_CTA_PREVIEW=true
# Checked-in Kompas examples are never shown in production. Enable locally only.
NEXT_PUBLIC_COMPASS_DEMO_PREVIEW=false
